# samples/make_samples.py, и в репозитории они не нужны.
samples/tampered.trustvisor
samples/unattested.trustvisor

# Резервные копии редакторов и скриптов правок: рядом с текущим ядром они
# показывали бы его предыдущую редакцию.
*.bak-*
*.bak
