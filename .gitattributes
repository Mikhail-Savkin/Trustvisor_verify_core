# Переводы строк — только LF, на всех системах.
#
# Это не вкусовщина. Проверка подписи считает хэши по СЫРЫМ байтам, и тот же
# код работает на сервере под Linux. Если git станет переписывать концы строк
# под систему разработчика, файлы у него разойдутся с боевыми побайтно —
# сверка копий покраснеет, а причина будет выглядеть как мистика.
* text=auto eol=lf

# Съёмки-образцы — двоичные, трогать их нельзя ничем и никогда.
*.trustvisor binary
